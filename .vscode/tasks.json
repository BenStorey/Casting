{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build",
      "type": "shell",
      "command": "cargo build",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$rustc"],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Build (release)",
      "type": "shell",
      "command": "cargo build --release",
      "group": "build",
      "problemMatcher": ["$rustc"],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Test",
      "type": "shell",
      "command": "cargo test",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$rustc"],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Test (single) — prompt for test name",
      "type": "shell",
      "command": "cargo test ${input:testFilter}",
      "group": "test",
      "problemMatcher": ["$rustc"],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Lint (clippy)",
      "type": "shell",
      "command": "cargo clippy --all-targets -- -D warnings",
      "group": "build",
      "problemMatcher": ["$rustc"],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Format (rustfmt)",
      "type": "shell",
      "command": "cargo fmt",
      "group": "build",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Run cast smoke test",
      "type": "shell",
      "command": "rm -rf .tmp-demo && ./target/debug/cast init .tmp-demo/demo-project && ./target/debug/cast smoke .tmp-demo/demo-project && ./target/debug/cast smoke .tmp-demo/demo-project",
      "dependsOn": ["Build"],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    }
  ],
  "inputs": [
    {
      "id": "testFilter",
      "type": "promptString",
      "description": "Partial test name to filter (e.g. cursor_starts_zero). Empty runs all.",
      "default": ""
    }
  ]
}
