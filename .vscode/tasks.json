{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build (Rust only)",
      "group": { "kind": "build", "isDefault": true },
      "type": "shell",
      "command": "cargo build",
      "problemMatcher": ["$rustc"],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Test",
      "group": { "kind": "test", "isDefault": true },
      "type": "shell",
      "command": "cargo test",
      "problemMatcher": ["$rustc"],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Lint (clippy)",
      "type": "shell",
      "command": "cargo clippy --all-targets -- -D warnings",
      "problemMatcher": ["$rustc"],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Format (rustfmt)",
      "type": "shell",
      "command": "cargo fmt",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Purge project",
      "detail": "Delete .casting/ state from the demo workspace.",
      "type": "shell",
      "command": "cargo run -- purge ~/casting-workspace/proj --force",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Run Frontend",
      "detail": "Start Vite dev server at :5000.",
      "type": "shell",
      "command": "cd frontend && npm run dev",
      "problemMatcher": [],
      "runOptions": { "instanceLimit": 1 },
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "frontend", "clear": true }
    }
  ]
}